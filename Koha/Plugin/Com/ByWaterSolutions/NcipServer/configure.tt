[% USE raw %]
[% USE Asset %]
[% USE Koha %]

[% WRAPPER 'wrapper-staff-tool-plugin.inc' plugin_title = "NCIP server" method = 'configure' %]

    [% Asset.css("lib/codemirror/codemirror.min.css") | $raw %]
    [% Asset.css("lib/codemirror/lint.min.css") | $raw %]
    <style>
      .CodeMirror {
        border: 2px solid #eee;
        height: auto;
      }
    </style>

    <h1>NCIP server configuration</h1>

    [% IF errors %]
        [% FOREACH error IN errors %]
            <div class="alert alert-warning">
                [% SWITCH error.code %]
                [% CASE 'CONFIGURATION_NOT_SAVED' %]<span>The configuration was not saved, it is not valid YAML. The previously saved configuration is still in effect.</span>
                [% CASE 'CONFIGURATION_INVALID' %]<span>The configuration is not valid YAML and could not be loaded</span>
                [% CASE 'CONFIG_SCHEMA' %]<span>Configuration problem: [% error.error | html %]</span>
                [% CASE 'AUTH_TOKEN_MISSING' %]<span>The configuration sets 'token_required' but no 'auth_token' is set</span>
                [% CASE 'USERENV_NOT_SET' %]<span>The configuration does not set 'koha.userenv_borrowernumber'</span>
                [% CASE 'USERENV_NOT_FOUND' %]<span>No patron found for 'koha.userenv_borrowernumber' ([% error.borrowernumber | html %])</span>
                [% CASE %]<span>Unhandled error ([% error | html %])</span>
                [% END %]
            </div>
        [% END %]
    [% END %]

    <h2>Configuration</h2>
    <br/>
    <form method="post">
      [% INCLUDE 'csrf-token.inc' %]
      <input type="hidden" name="class"  value="[% CLASS | html %]"/>
      <input type="hidden" name="method" value="configure"/>
      <input type="hidden" name="op"     value="cud-save"/>
      <div class="input-group">
        <span class="input-group-addon" id="configuration_label">Configuration</span>
        <textarea rows="20"
                  class="form-control"
                  aria-describedby="configuration_label"
                  name="configuration"
                  id="configuration">[%- configuration | $raw -%]</textarea>
      </div>
      <br/>
      <button type="submit" class="btn btn-default">Save configuration</button>
    </form>

    [% Asset.js( "lib/codemirror/codemirror.min.js" ) | $raw %]
    [% Asset.js( "lib/codemirror/yaml.min.js" ) | $raw %]
    [% Asset.js( "lib/codemirror/lint.min.js" ) | $raw %]
    [% Asset.js( "lib/linters/js-yaml.min.js" ) | $raw %]
    [% Asset.js( "lib/codemirror/yaml-lint.min.js" ) | $raw %]

    <script nonce="[% Koha.CSPNonce | $raw %]">
        // The editor is set up inline rather than on document ready, the page
        // scripts including jQuery are loaded after this content by the wrapper
        var editor = CodeMirror.fromTextArea( document.getElementById( "configuration" ), {
            lineNumbers: true,
            mode: 'text/x-yaml',
            lineWrapping: false,
            gutters: ["CodeMirror-lint-markers"],
            lint: true
        });
        editor.setSize(1000, 300);
    </script>

[% END %]
